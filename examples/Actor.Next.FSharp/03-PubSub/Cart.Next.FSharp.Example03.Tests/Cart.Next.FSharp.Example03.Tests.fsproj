<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cart.Next.FSharp.Example03.Actors\Cart.Next.FSharp.Example03.Actors.fsproj" />
    <ProjectReference Include="..\Cart.Next.FSharp.Example03.Glue\Cart.Next.FSharp.Example03.Glue.csproj" />
    <ProjectReference Include="..\..\..\..\src\Dapr.Actors.Next.Streams\Dapr.Actors.Next.Streams.csproj" />
    <ProjectReference Include="..\..\..\..\src\Dapr.Actors.Next.Testing\Dapr.Actors.Next.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PubSubTests.fs" />
  </ItemGroup>

</Project>
