<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Approvals.Next.FSharp.Example06.Actors\Approvals.Next.FSharp.Example06.Actors.fsproj" />
    <ProjectReference Include="..\Approvals.Next.FSharp.Example06.Glue\Approvals.Next.FSharp.Example06.Glue.csproj" />
    <ProjectReference Include="..\..\..\..\src\Dapr.Actors.Next.Testing\Dapr.Actors.Next.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestWorkflowContext.fs" />
    <Compile Include="RecordingWorkflowClient.fs" />
    <Compile Include="ApprovalMachineTests.fs" />
    <Compile Include="VerificationTests.fs" />
    <Compile Include="SettlementWorkflowTests.fs" />
    <Compile Include="SettlementCompositionTests.fs" />
  </ItemGroup>

</Project>
