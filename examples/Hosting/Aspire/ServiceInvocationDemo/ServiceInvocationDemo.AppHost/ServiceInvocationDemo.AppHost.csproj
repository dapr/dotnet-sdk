<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>false</WarningsAsErrors>
        <UserSecretsId>5d18c5e4-5752-4a7d-a461-88e9e4bcbacf</UserSecretsId>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <NoWarn>$(NoWarn);CS8002</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == ''">
        <!-- The SDK RID task is not registered in the outer cross-targeting build. -->
        <_AspireUseSdkPickBestRid>false</_AspireUseSdkPickBestRid>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BackendApp\BackendApp.csproj" />
      <ProjectReference Include="..\FrontendApp\FrontendApp.csproj" />
    </ItemGroup>

</Project>
