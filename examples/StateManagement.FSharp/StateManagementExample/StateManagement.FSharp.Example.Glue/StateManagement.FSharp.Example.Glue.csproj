    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DaprStateManagementScanReferences>true</DaprStateManagementScanReferences>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
