<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <DaprStateManagementScanReferences>true</DaprStateManagementScanReferences>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DaprStateManagementScanReferences" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dapr.IntegrationTest.FSharp.StateManagement.Types\Dapr.IntegrationTest.FSharp.StateManagement.Types.fsproj" />
    <ProjectReference Include="..\..\src\Dapr.StateManagement.Abstractions\Dapr.StateManagement.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Dapr.StateManagement.Runtime\Dapr.StateManagement.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Dapr.StateManagement.Generators\Dapr.StateManagement.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
