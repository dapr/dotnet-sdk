<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.v3.extensibility.core" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Dapr.AspNetCore\Dapr.AspNetCore.csproj" />
      <ProjectReference Include="..\..\src\Dapr.Client\Dapr.Client.csproj" />
      <ProjectReference Include="..\..\src\Dapr.Testcontainers.Xunit\Dapr.Testcontainers.Xunit.csproj" />
      <ProjectReference Include="..\..\src\Dapr.Testcontainers\Dapr.Testcontainers.csproj" />
      <ProjectReference Include="..\..\src\Dapr.Workflow.Abstractions\Dapr.Workflow.Abstractions.csproj" />
      <!-- Dapr.Workflow references this with PrivateAssets="all" so it does not flow transitively;
           the stateful-history observer needs the generated WorkItem/WorkflowRequest types, the same
           way Dapr.Workflow.Test references it directly. -->
      <ProjectReference Include="..\..\src\Dapr.Workflow.Grpc\Dapr.Workflow.Grpc.csproj" />
      <ProjectReference Include="..\..\src\Dapr.Workflow\Dapr.Workflow.csproj" />
    </ItemGroup>

</Project>
