<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\properties\dapr_managed_netcore.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" Condition="$(MSBuildProjectName.StartsWith('Dapr.Actors.Next'))" />

  <PropertyGroup>  
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(DaprEnableNet11)' == 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
      
    <!-- Set Output Path for tests-->
    <OutputPath>$(RepoRoot)bin\$(Configuration)\test\$(MSBuildProjectName)\</OutputPath>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
      <!-- Required for InternalsVisibleTo with PublicKey in target project -->
      <SignAssembly>true</SignAssembly>
      <NoWarn>$(NoWarn);CS8002;DAPR_CONVERSATION;DAPR_DISTRIBUTEDLOCK;DAPR_CRYPTOGRAPHY</NoWarn>
  </PropertyGroup>

  <!-- Used to annotate PR with test failures: https://github.com/Tyrrrz/GitHubActionsTestLogger -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="GitHubActionsTestLogger" />
  </ItemGroup>
</Project>
